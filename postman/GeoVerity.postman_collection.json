              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"dev_pixel8_gv_984128\",\n  \"clientTimestamp\": 1788440712000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/time/token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "time", "token"]
            }
          }
        }
      ]
    },
